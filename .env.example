# ASK reference client — environment template (brief T4)
# Copy to .env and adjust. NEVER commit .env or funded keys.

# SQLite index/cache (the chain is the source of truth — brief §3.3)
DATABASE_URL="file:./dev.db"

# Kaspa network. DEFAULT is the current covenant testnet (brief D10).
# Ground truth 2026-08-03: testnet-10 carries the post-Toccata ruleset.
# NEVER default to mainnet; mainnet is out of scope for this brief.
KASPA_NETWORK_ID="testnet-10"

# wRPC node endpoint. Leave empty to use the SDK Resolver against the
# public node network for KASPA_NETWORK_ID.
KASPA_WRPC_URL=""

# Explorer base for C4 links (tx URL pattern verified in Phase 0/1)
EXPLORER_TX_URL_BASE="https://explorer-tn10.kaspa.org/txs/"

# There is deliberately no fee address and no fee configuration (brief D2).
